OBOT_ENV=dev
OBOT_DATABASE_URL=postgresql+asyncpg://obot:obot@localhost:5433/obot
OBOT_REDIS_URL=redis://localhost:6380/0
# Token of the factory bot from @BotFather (Bot Management Mode must be enabled)
OBOT_FACTORY_BOT_TOKEN=
OBOT_PUBLIC_BASE_URL=
# Generate with: uv run python -c "from obot.crypto import TokenCipher; print(TokenCipher.generate_key_b64())"
OBOT_TOKEN_ENCRYPTION_KEY=
OBOT_OPENROUTER_API_KEY=
OBOT_TAVILY_API_KEY=
# Optional: Langfuse tracing
OBOT_LANGFUSE_PUBLIC_KEY=
OBOT_LANGFUSE_SECRET_KEY=
