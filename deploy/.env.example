# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Public address of the server. Production: your domain with HTTPS.
DOMAIN=obot.example.com
PUBLIC_URL=https://obot.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Same meaning as in backend/.env.example
OBOT_FACTORY_BOT_TOKEN=
OBOT_TOKEN_ENCRYPTION_KEY=
OBOT_OPENROUTER_API_KEY=
OBOT_TAVILY_API_KEY=
OBOT_ADMIN_TG_IDS=
OBOT_UPDATE_MODE=webhook
OBOT_SENTRY_DSN=
OBOT_LANGFUSE_PUBLIC_KEY=
OBOT_LANGFUSE_SECRET_KEY=
